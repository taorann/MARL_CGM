PLANNER_MODEL=qwen3-coder-480b-a35b-instruct
PLANNER_API_KEY=
PLANNER_ENABLE_THINKING=0
PLANNER_TEMPERATURE=0

CGM_BACKEND=dashscope
CGM_DASHSCOPE_MODEL=qwen3-235b-a22b-thinking-2507
CGM_DASHSCOPE_ENABLE_THINKING=1
CGM_DASHSCOPE_TEMPERATURE=0
CGM_DASHSCOPE_MAX_TOKENS=1536
CGM_DASHSCOPE_TIMEOUT=1200

GRAPHPLANNER_SWEB_REMOTE_ROOT=/lustre3/chongbin_pkuhpc/chongbin_cls/graphplanner_sif
GRAPHPLANNER_PRO_REMOTE_ROOT=/lustre3/chongbin_pkuhpc/chongbin_cls/graphplanner_sif
GRAPHPLANNER_SANDBOX_REMOTE_REPO=/appsnew/home/chongbin_pkuhpc/chongbin_cls/MARL_CGM
GRAPHPLANNER_SANDBOX_SSH_TARGET=chongbin_cls@127.0.0.1
